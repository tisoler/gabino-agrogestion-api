# Database
DB_HOST=localhost
DB_PORT=5434
DB_USERNAME=gabino_usuario_bd
DB_PASSWORD=
DB_DATABASE=gabino_agrogestion

# Server
PORT=3065

# DigitalOcean Spaces (PDFs de prescripciones compartidos por WhatsApp)
# Endpoint del Space (ej: https://nyc3.digitaloceanspaces.com)
DO_SPACES_ENDPOINT=
# Región del Space (ej: nyc3). Opcional, default: nyc3
DO_SPACES_REGION=
# Access key de Spaces
DO_SPACES_KEY=
# Secret key de Spaces
DO_SPACES_SECRET=
# Nombre del bucket (Space)
DO_SPACES_BUCKET=
# URL pública base para armar los links. Opcional; por defecto se arma como
# https://<DO_SPACES_BUCKET>.<DO_SPACES_REGION>.digitaloceanspaces.com
DO_SPACES_PUBLIC_URL=

# Copernicus Data Space Ecosystem (NDVI Sentinel-2 en /analisis)
# Cuenta gratuita en https://dataspace.copernicus.eu → Manage Account →
# Identity & Access Management → Add New Client (OpenID Connect,
# client credentials). Con credenciales el NDVI usa Sentinel-2 (10–20 m);
# sin ellas cae al fallback VIIRS 8-day de NASA GIBS (~500 m, sin key).
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
# % máximo de cobertura de nubes aceptado por escena Sentinel-2 (default 40)
S2_MAX_CLOUD_PERCENT=40

# OCR de análisis de suelo (binarios del sistema: poppler-utils + tesseract-ocr
# con datos `spa`). En macOS el binario de brew no lee de /tmp: apuntar a un
# dir del proyecto (ej: OCR_TMPDIR=./.tmp-ocr). En Linux/Docker vale /tmp.
# OCR_TMPDIR=
# DPI de render del PDF (default 300), timeout ms por archivo (default 120000),
# máx páginas por PDF (default 5), máx MB por archivo (default 15).
# OCR_DPI=300
# OCR_TIMEOUT_MS=120000
# OCR_MAX_PAGES=5
# OCR_MAX_MB=15

